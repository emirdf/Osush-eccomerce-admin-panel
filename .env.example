# ─── API ──────────────────────────────────────────────────────────────────────
# Base URL of the REST API (no trailing slash).
#
# The API currently sends no CORS headers, so a browser cannot call it directly
# from another origin. Two ways to run:
#
# 1. Local development through the Vite proxy (recommended today):
#      VITE_API_BASE_URL=/api/v1
#      VITE_DEV_API_TARGET=https://osush72-production.up.railway.app
#
# 2. Directly, once the backend allows the panel's origin (see API_GAPS.md §5):
#      VITE_API_BASE_URL=https://osush72-production.up.railway.app/api/v1
#      VITE_DEV_API_TARGET=
#
# In production, serve the panel behind the same domain as the API or enable CORS.
VITE_API_BASE_URL=/api/v1
VITE_DEV_API_TARGET=https://osush72-production.up.railway.app

# ─── Media ────────────────────────────────────────────────────────────────────
# Optional: rewrite image hosts returned by the API. Responses may point at
# http://localhost:9000 (MinIO in dev); set this to the reachable media origin.
VITE_MEDIA_BASE_URL=
